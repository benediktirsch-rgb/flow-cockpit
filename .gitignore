# ── Flow Cockpit — was NICHT in die Versionsverwaltung gehört ────────────────
desktop.ini
Thumbs.db
.DS_Store
node_modules/

# Sitzungsstand von Claude Code (Berechtigungen, lokale Overrides, Notizen) — nur die Skills
# reisen mit (04.09.2026 abends, Bene: mobil dieselben Skills wie am Desktop).
.claude/*
!.claude/skills/
CLAUDE.local.md

# Laufzeit-Protokolle
*.log

# Generierte Daten der Vishnu-Instanz: schreibt der GitHub-Workflow update-va-data.yml
# stündlich aus Jira und lädt sie per FTPS hoch — nie lokal schreiben oder committen.
site/va/va-data.json

# Zugangsdateien (HTTP-Basic-Auth) entstehen im Workflow aus dem Secret VA_HTPASSWD
.htpasswd*
docs/va.htpasswd
# Die Tuer von va. (seit 04.09.2026): Konfiguration mit Maschinenschluessel und Cookie-Geheimnis
# legt publish-cockpit.ps1 einmal an — beides bleibt auf diesem Rechner und dem Server.
site/va/gate-config.php
site/va/gate-secret.php

# Kundeninstanzen: Namen, Board-URLs, Zugangs-Hashes — bleiben lokal
instanzen/
# Hash-Stand der FTPS-Uploads je Subdomain (publish-cockpit.ps1)
site/.publish-state/
publish-cockpit.log

# memanto (12.09.2026, Bene): Gedächtnis über Sessions. Hooks und settings.json reisen mit,
# damit mobile Sessions dieselben Hooks haben wie der Desktop; MEMORY.md/okf/ schreibt
# „memanto memory sync“ aus dem Backend — generiert, nie committen. Details: docs/memanto.md
!.claude/hooks/
!.claude/settings.json
MEMORY.md
okf/
