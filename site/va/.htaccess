# Team-Cockpit va.vishnuartists.com — jede Anfrage geht durch gate.php (seit 04.09.2026 abends).
# Vorher: HTTP-Basic-Auth mit einem gemeinsamen Team-Passwort (.htpasswd-va, 25.08.–04.09.2026).
# Jetzt: dieselbe Tuer wie die persoenlichen Subdomains — die Person kommt mit ihrem Konto von
# vishnuartists.com herein (weiter.php-Ticket, Tuercookie vf_gate), wer darf steht in gate-config.php,
# Leser ohne Konto (john-server, Datenlauf) schicken den Maschinenschluessel im Kopf X-Vf-Key.
# gate.php ist eine Kopie aus flow-compass/produkt/gate/ und wird von publish-cockpit.ps1 nachgezogen.
# Rueckweg zur alten Tuer: diese Datei aus dem Commit vor der Umstellung (docs/va-zugangsschutz.md).
# gate-fassung: 1
<IfModule mod_rewrite.c>
RewriteEngine On
# https erzwingen: das Ticket und das Tuercookie gehoeren nie ueber eine offene Leitung.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# Alles andere beantwortet die Tuer. Sie liefert die Datei selbst aus, wenn jemand
# angemeldet ist (oder den Schluessel hat), und schickt sonst zu vishnuartists.com/weiter.php.
RewriteCond %{REQUEST_URI} !^/gate\.php$
RewriteRule ^(.*)$ /gate.php [QSA,L]
</IfModule>
# Ohne mod_rewrite gaebe es keine Tuer — dann lieber gar nichts ausliefern als alles.
<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
# Die Tuerdateien sind auch dann tabu, wenn jemand sie direkt anspricht.
<FilesMatch "^(gate-config|gate-secret)\.php$">
  Require all denied
</FilesMatch>
# CORS fuer den persoenlichen Compass (bene.vishnuartists.com liest va-data.json) setzt gate.php
# selbst — je nach Origin, nur fuer *.vishnuartists.com, mit Cookie.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>
